<!-- Royal Mix Global — Home Screen (Pi Studio XML / HTML block) -->
<Page id="home" background="#0A0A0A">
  <!-- Topbar -->
  <Container id="topbar" style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:linear-gradient(135deg,#0044FF,#7A00FF);">
    <Container style="display:flex;align-items:center;gap:10px;">
      <Image src="https://yourcdn/logo_white_gold.png" alt="Royal Mix Logo" style="width:48px;height:48px;border-radius:8px;"/>
      <Text style="color:#FFD300;font-weight:800;font-size:18px;">ROYAL MIX GLOBAL</Text>
    </Container>
    <Container style="display:flex;gap:12px;align-items:center;">
      <Button id="promoteBtn" style="background:#FFD300;color:#0A0A0A;padding:8px 12px;border-radius:8px;border:none;font-weight:700;">Promote My Business</Button>
      <IconButton id="notif" icon="bell" color="#FFD300" />
      <IconButton id="profile" icon="user" color="#FFFFFF" />
    </Container>
  </Container>

  <!-- Hero -->
  <Container id="hero" style="padding:22px;background:#0A0A0A;text-align:center;">
    <Text style="color:#FFD300;font-size:26px;font-weight:800;margin-bottom:6px;">WELCOME TO ROYAL MIX GLOBAL 👑</Text>
    <Text style="color:#E6B800;font-size:14px;margin-bottom:14px;">Fast. Fresh. Smart Delivery — Food, Health, Liquor & More.</Text>

    <Container style="display:flex;gap:12px;justify-content:center;">
      <Button id="orderNow" style="background:#A00000;color:#FFFFFF;padding:12px 18px;border-radius:12px;font-weight:800;" action="openCategory('all')">ORDER NOW</Button>
      <Button id="explore" style="background:transparent;border:2px solid #FFD300;color:#FFD300;padding:10px 16px;border-radius:12px;font-weight:700;" action="openMarketplace()">EXPLORE MARKETPLACE</Button>
    </Container>
  </Container>

  <!-- Search -->
  <Container style="padding:12px 16px;">
    <Input id="search" placeholder="Search food, drinks, liquor, services..." style="width:100%;background:#1A1A1A;color:#FFD300;padding:12px;border-radius:12px;border:1px solid #333;" onChange="searchSuggest(value)"/>
  </Container>

  <!-- Categories Row -->
  <Container id="categories" style="display:flex;gap:10px;overflow-x:auto;padding:12px 16px;">
    <!-- repeat per category -->
    <Container class="cat" style="min-width:84px;text-align:center;">
      <Container style="background:#FFD300;width:64px;height:64px;border-radius:32px;display:flex;align-items:center;justify-content:center;margin:0 auto;">
        <Text style="color:#0A0A0A;font-weight:800;font-size:22px;">🍗</Text>
      </Container>
      <Text style="color:#FFFFFF;margin-top:8px;">Food</Text>
    </Container>

    <Container class="cat" style="min-width:84px;text-align:center;">
      <Container style="background:#FFD300;width:64px;height:64px;border-radius:32px;display:flex;align-items:center;justify-content:center;margin:0 auto;">
        <Text style="color:#0A0A0A;font-weight:800;font-size:22px;">🍷</Text>
      </Container>
      <Text style="color:#FFFFFF;margin-top:8px;">Liquor</Text>
    </Container>

    <Container class="cat" style="min-width:84px;text-align:center;">
      <Container style="background:#FFD300;width:64px;height:64px;border-radius:32px;display:flex;align-items:center;justify-content:center;margin:0 auto;">
        <Text style="color:#0A0A0A;font-weight:800;font-size:22px;">💊</Text>
      </Container>
      <Text style="color:#FFFFFF;margin-top:8px;">Pharmacy</Text>
    </Container>

    <!-- add more categories similarly -->
  </Container>

  <!-- Next Delivery Card -->
  <Container style="padding:12px 16px;">
    <Container style="background:#1A1A1A;border-radius:12px;padding:12px;display:flex;justify-content:space-between;align-items:center;">
      <Container>
        <Text style="color:#FFD300;font-weight:700;">Next delivery</Text>
        <Text id="nextOrderId" style="color:#FFFFFF;font-weight:800;">{{orders[0].order_id || '—'}}</Text>
        <Text id="nextETA" style="color:#CCCCCC;">{{orders[0].eta || ''}}</Text>
      </Container>
      <Button id="trackBtn" style="background:#E0B000;color:#000000;padding:10px 14px;border-radius:10px;font-weight:800;" action="openTracker('{{orders[0].order_id}}')">TRACK</Button>
    </Container>
  </Container>

  <!-- Promotions / Offers slider -->
  <Container style="padding:12px 16px;">
    <Text style="color:#FFD300;font-weight:800;margin-bottom:8px;">Special Offers</Text>
    <Carousel id="promoCarousel" style="height:120px;border-radius:12px;overflow:hidden;">
      <Slide>
        <Container style="background:#FFD300;padding:12px 16px;height:100%;display:flex;flex-direction:column;justify-content:center;">
          <Text style="font-weight:800;color:#0A0A0A;">Royal Launch — 20% Off</Text>
          <Text style="color:#0A0A0A;">Use code ROYAL20</Text>
        </Container>
      </Slide>
      <Slide>
        <Container style="background:#A00000;padding:12px 16px;height:100%;display:flex;flex-direction:column;justify-content:center;">
          <Text style="font-weight:800;color:#FFFFFF;">Free Health Delivery</Text>
          <Text style="color:#FFFFFF;">Lusaka only</Text>
        </Container>
      </Slide>
    </Carousel>
  </Container>

  <!-- Featured Stores (data bound list) -->
  <Container style="padding:12px 16px;">
    <Text style="color:#FFD300;font-size:18px;font-weight:800;margin-bottom:10px;">Featured Stores</Text>
    <ListView id="featuredStores" dataSource="stores" style="display:flex;flex-direction:column;gap:12px;">
      <ListItem template="storeCard">
        <Container style="background:#1A1A1A;border-radius:12px;padding:12px;">
          <Image src="{{item.banner}}" style="width:100%;height:140px;border-radius:8px;object-fit:cover;" />
          <Text style="color:#FFD300;font-weight:800;margin-top:10px;">{{item.name}}</Text>
          <Text style="color:#FFFFFF;margin:4px 0 2px;">{{item.category}}</Text>
          <Text style="color:#E6B800;font-weight:700;">★ {{item.rating}} • {{item.delivery_time}}</Text>
          <Container style="display:flex;gap:8px;margin-top:10px;">
            <Button style="flex:1;background:#FFD300;color:#0A0A0A;border-radius:10px;font-weight:800;" action="openStore('{{item.id}}')">VIEW STORE</Button>
            <Button style="flex:1;background:transparent;border:2px solid #FFD300;color:#FFD300;border-radius:10px;font-weight:800;" action="quickOrder('{{item.id}}')">ORDER NOW</Button>
          </Container>
        </Container>
      </ListItem>
    </ListView>
  </Container>

  <!-- Footer / Bottom navigation -->
  <Container id="bottomNav" style="position:fixed;bottom:0;left:0;right:0;background:#0A0A0A;padding:10px 14px;display:flex;justify-content:space-around;border-top:1px solid #222;">
    <NavButton id="homeNav" icon="home" label="Home" colorActive="#FFD300" action="goHome()" />
    <NavButton id="shopNav" icon="shopping-bag" label="Shop" colorActive="#FFD300" action="openMarketplace()" />
    <NavButton id="walletNav" icon="wallet" label="Wallet" colorActive="#FFD300" action="openWallet()" />
    <NavButton id="ordersNav" icon="map-pin" label="Orders" colorActive="#FFD300" action="openOrders()" />
    <NavButton id="aiNav" icon="feather" label="AI" colorActive="#FFD300" action="openAIHub()" />
  </Container>
</Page>
