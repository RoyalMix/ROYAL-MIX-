      <View style={styles.hero}>
        <Text style={styles.heroTitle}>WELCOME TO ROYAL MIX GLOBAL 👑</Text>
        <Text style={styles.heroSub}>Fast. Fresh. Smart Delivery</Text>
        <View style={styles.heroBtns}>
